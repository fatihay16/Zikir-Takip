{
  "appId": "com.fatihay16.zikirtakip.yeni",
  "appName": "Günlük Zikir Takip",
  "webDir": "www",
  "backgroundColor": "#103b2b",
  "android": {
    "allowMixedContent": false,
    "captureInput": false,
